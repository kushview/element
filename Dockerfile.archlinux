# Dockerfile for building and testing Element on Arch Linux
# This creates a build environment - mount your source code as a volume
FROM archlinux:latest

# Update system and install dependencies
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
        git \
        base-devel \
        cmake \
        ninja \
        pkgconf \
        boost \
        freetype2 \
        fontconfig \
        libx11 \
        libxext \
        libxrandr \
        libxcomposite \
        libxinerama \
        libxrender \
        libxcursor \
        alsa-lib \
        jack2 \
        lv2 \
        lilv \
        suil \
        ladspa \
        curl \
        ttf-roboto \
        clang \
        pandoc \
        python \
        ccache && \
    pacman -Scc --noconfirm

# Python packages for building the user manual, in a venv on the PATH so
# CMake picks them up.
COPY docs/manual/requirements.txt /tmp/manual-requirements.txt
RUN python -m venv /opt/element-docs && \
    /opt/element-docs/bin/pip install --no-cache-dir -r /tmp/manual-requirements.txt && \
    rm /tmp/manual-requirements.txt
ENV PATH="/opt/element-docs/bin:${PATH}"

# Set up working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
